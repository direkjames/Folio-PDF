# Copy this file to android/key.properties and fill it in. key.properties is git-ignored.
# storeFile can be an absolute path (use forward slashes on Windows, e.g. C:/keys/folio-release.jks).
storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=folio
storeFile=C:/keys/folio-release.jks
